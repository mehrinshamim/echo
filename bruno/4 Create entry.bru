meta {
  name: 4 Create entry
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/entries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "transcript": "I keep wondering if I should quit my job to build my own product. The salary is safe but I feel stuck.",
    "created_at": "2026-09-01T09:00:00Z"
  }
}

script:post-response {
  // Remember the new entry so "6 Get entry" can open it
  if (res.body.id) {
    bru.setVar("entryId", res.body.id);
  }
}

docs {
  Needs a real LLM key in backend/.env.
  Edit the transcript and send several. "created_at" is optional: use it to fake past dates.
  Returns the entry with title, summary, themes, and echoes (similar older entries).
}

# Copy to backend/.env and fill in. Never commit .env.

# Supabase: Project Settings -> API (anon / publishable key, NOT service_role)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Provider keys: only the providers you use need one
GEMINI_API_KEY=your-gemini-key        # https://aistudio.google.com (free tier)
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# Chat (gemini | gemma | openai | groq). FAST = every log / question, SMART = reports, styles, drafts
CHAT_PROVIDER=gemini
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.5-flash-lite
# Demo on OpenAI instead:
# CHAT_PROVIDER=openai
# MODEL_FAST=gpt-5-mini
# MODEL_SMART=gpt-5-mini

# Open-weight Gemma 4 31B via the Gemini API (same GEMINI_API_KEY; free tier is ~15 requests/min, 1,500/day).
# Model ids: gemma-4-31b-it (used here) or gemma-4-26b-a4b-it (lighter).
# CHAT_PROVIDER=gemma
# MODEL_FAST=gemma-4-31b-it
# MODEL_SMART=gemma-4-31b-it
# Chat calls per minute this server may make (0 = no cap); keep at/below your provider's free limit
# LLM_RPM=15

# Optional backup when the chat provider errors (used for both tiers)
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=openai/gpt-oss-120b

# Embeddings (gemini | openai | ollama). Gemma is not an embedding model, so Gemini stays the default.
# Changing provider/model means re-embedding all data (`python -m scripts.seed --wipe`) AND retuning
# THEME_MATCH_THRESHOLD (0.85), ECHO_THRESHOLD (0.75) and ASK_MIN_SIMILARITY (0.5) in config.py.
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
# Optional open-weight embeddings, served locally by Ollama (`ollama pull embeddinggemma`), 768 dims = pgvector column size:
# EMBED_PROVIDER=ollama
# EMBED_MODEL=embeddinggemma
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Copy to backend/.env and fill in. Never commit .env.

# Supabase: Project Settings -> API (anon / publishable key, NOT service_role)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# LLM: any OpenAI-compatible endpoint.
# Dev (free): Gemini, key from https://aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key
MODEL_FAST=gemini-2.5-flash
MODEL_SMART=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Demo: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# MODEL_FAST=gpt-4.1-mini
# MODEL_SMART=gpt-4.1
# EMBED_MODEL=text-embedding-3-small

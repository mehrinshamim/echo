  token: {{token}}
}

body:json {
  {
    "question": "What did I learn at hackathons?",
    "theme_ids": [],
    "log_ids": []
  }
}

script:post-response {
  if (res.body.chat_id) bru.setVar("chatId", res.body.chat_id);
}

docs {
